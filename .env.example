# Runtime only. No secret is needed for the basic game.
PORT=3000
SEED=20251018
MAX_PLAYERS=64
# Must be a persistent directory on your host. Docker default is /app/data.
DATA_DIR=./data
# Production origin, no trailing slash. Empty accepts the request's same host.
# PUBLIC_ORIGIN=https://play.example.com
# Optional WebRTC ICE servers. STUN alone does not work across every NAT.
# Use short-lived TURN credentials for a public production game.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

; Veyra Native — a real Godot client, never a WebView.
config_version=5

[application]
config/name="Veyra: Neon District — Native Alpha"
config/version="0.5.2-alpha.3"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"
boot_splash/bg_color=Color(0.02, 0.04, 0.07, 1)
boot_splash/show_image=true
boot_splash/stretch_mode=1
boot_splash/use_filter=true
boot_splash/image="res://assets/boot_splash.png"
boot_splash/minimum_display_time=1200
config/use_custom_user_dir=true
config/custom_user_dir_name="VeyraNeonDistrict"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/vsync/vsync_mode=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=2
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
lights_and_shadows/directional_shadow/size=2048
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.025, 0.045, 0.075, 1)

[physics]
common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[audio]
driver/enable_input=false

[network]
limits/debugger/max_queued_messages=1024

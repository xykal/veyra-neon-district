{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veyra-neon-district",
  "main": "cloudflare/index.js",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/cloudflare-assets",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/healthz", "/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [{"name": "CITY", "class_name": "City"}]
  },
  "migrations": [{"tag": "city-sql-v1", "new_sqlite_classes": ["City"]}],
  "vars": {
    "SEED": "20251018",
    "MAX_PLAYERS": "16",
    "BUILD_SHA": "local"
  },
  "observability": {"enabled": false}
}
